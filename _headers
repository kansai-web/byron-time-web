# 検索エンジンに載せたくないパスの指定
# HTML の <meta name="robots"> は画像やPDFには効かないため、
# フォルダ配下すべてに効くヘッダーをここで付ける。

# 旧「うちの子グッズ」LP（新しい /uchinoko/ に置き換え予定）
/byron-time/*
  X-Robots-Tag: noindex

# 新「うちの子グッズ」受注サイト（準備中）
# ★公開するときに、この2行を削除する。
#   各HTMLの <meta name="robots" content="noindex"> も一緒に外すこと。
/uchinoko/*
  X-Robots-Tag: noindex

# クライアント案件（公開前の限定公開）
/marucafe/*
  X-Robots-Tag: noindex

# デモサイト
/demo-kitchencar/*
  X-Robots-Tag: noindex

/demo-komeko/*
  X-Robots-Tag: noindex

/demo-pilotcoffee/*
  X-Robots-Tag: noindex

/demo-soraotomisaki/*
  X-Robots-Tag: noindex

/soraotomisaki-preview/*
  X-Robots-Tag: noindex
